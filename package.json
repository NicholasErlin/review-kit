{
  "name": "@horus52/review-kit",
  "version": "1.1.0",
  "description": "Track a code review in review.json (issues, fixes with before/after evidence, plan) and publish an offline, phone-friendly static review site.",
  "keywords": [
    "code-review",
    "review",
    "ux-audit",
    "screenshots",
    "before-after",
    "static-site",
    "agent-skill",
    "cli"
  ],
  "license": "MIT",
  "author": "Nicholas Erlin",
  "homepage": "https://github.com/NicholasErlin/review-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicholasErlin/review-kit.git"
  },
  "bugs": {
    "url": "https://github.com/NicholasErlin/review-kit/issues"
  },
  "type": "module",
  "bin": {
    "review-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "site",
    "schema",
    "skill",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "playwright": ">=1.30"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
