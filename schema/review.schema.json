{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NicholasErlin/review-kit/schema/review.schema.json",
  "title": "review-kit review.json (format version 1)",
  "description": "Issues found, fixes shipped (with before/after screenshots) and the remaining plan for one project; or the research, ideas and design proposals that come before them. Rich-text fields are sanitized Markdown or HTML. Asset paths must resolve inside the directory containing review.json.",
  "type": "object",
  "required": ["version", "project"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1, "description": "Format version. Bumped only on breaking changes." },
    "project": { "$ref": "#/$defs/project" },
    "platforms": {
      "type": "array",
      "description": "Variants the review covers (e.g. mobile, desktop). May be a single entry. Defaults to one platform with id \"default\".",
      "items": { "$ref": "#/$defs/platform" }
    },
    "severities": {
      "type": "array",
      "description": "Ordered most to least severe. Defaults to P0, P1, P2.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/severity" }
    },
    "areas": {
      "type": "array",
      "description": "Pages, screens or report sections. Issues refer to them by id.",
      "items": { "$ref": "#/$defs/area" }
    },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "fixes": { "type": "array", "items": { "$ref": "#/$defs/fix" } },
    "plan": {
      "type": "array",
      "description": "Roadmap groups, each with items that carry a status.",
      "items": { "$ref": "#/$defs/planGroup" }
    },
    "appendix": {
      "type": "array",
      "description": "Free-form extra sections shown under the plan (measurements, methodology, ...).",
      "items": { "$ref": "#/$defs/appendixEntry" }
    },
    "research": {
      "type": "array",
      "description": "Findings from research (codebase, docs, standards, studies, comparable products), each with sources a reader can open. Ideas cite them by id.",
      "items": { "$ref": "#/$defs/research" }
    },
    "ideas": {
      "type": "array",
      "description": "Proposed ideas with their reasoning, evidence, alternatives and risks, and the user's decision.",
      "items": { "$ref": "#/$defs/idea" }
    },
    "proposals": {
      "type": "array",
      "description": "Design proposals: two or more options built on their own branches, scored against criteria agreed up front.",
      "items": { "$ref": "#/$defs/proposal" }
    },
    "prs": {
      "type": "array",
      "description": "Pull requests on the dashboard (kind prs): your own and ones you review, across repositories. `review-kit pr sync` replaces each `gh` object; the other fields are yours.",
      "items": {
        "$ref": "#/$defs/pr"
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 120 },
    "rich": { "type": "string", "description": "Sanitized Markdown subset (or sanitized HTML when project.textFormat is html)." },
    "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
    "link": {
      "type": "object",
      "required": ["label", "href"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1, "description": "URL, or a path relative to review.json (copied into the site when it exists)." },
        "kind": { "type": "string", "description": "Optional hint: pdf, report, pr, doc, ..." }
      }
    },
    "image": {
      "description": "A screenshot: either a relative path, or an object with a caption.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["src"],
          "additionalProperties": false,
          "properties": {
            "src": { "type": "string", "minLength": 1 },
            "caption": { "$ref": "#/$defs/rich" },
            "alt": { "type": "string" }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "description": "Shown after the name in the header, e.g. \"UI/UX audit\". Default \"Review\"." },
        "kind": {"enum": ["ui", "backend", "ideas", "design", "prs"], "default": "ui", "description": "What the review covers: ui (UI/UX, with before/after screenshots), backend (code practices; evidence is code, tests and output), ideas (research and proposed ideas), design (options built on branches and compared) or prs (a dashboard of open pull requests across repositories, synced from GitHub). Agents pick their playbook and companion skills from it."},
        "description": { "$ref": "#/$defs/rich" },
        "date": { "type": "string", "description": "Review date, ISO 8601 preferred." },
        "repo": { "type": "string", "description": "Repository URL or path." },
        "textFormat": { "enum": ["markdown", "html"], "default": "markdown" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accent": { "$ref": "#/$defs/color" },
            "accentDark": { "$ref": "#/$defs/color" },
            "logoText": { "type": "string", "maxLength": 3, "description": "Up to 3 characters in the header badge. Default: first letter of name." }
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "shape": { "enum": ["portrait", "landscape", "auto"], "default": "auto", "description": "Screenshot orientation; auto detects from image sizes." },
        "description": { "type": "string" }
      }
    },
    "severity": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "color": { "$ref": "#/$defs/color" },
        "description": { "type": "string" }
      }
    },
    "area": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "num": { "type": "string", "description": "Optional display number, e.g. \"3\"." },
        "platform": { "type": "string" },
        "description": { "$ref": "#/$defs/rich" },
        "screenshots": { "type": "array", "items": { "$ref": "#/$defs/image" } }
      }
    },
    "issueStatus": { "enum": ["open", "partial", "fixed", "notabug", "wontfix"] },
    "issue": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "platform": { "type": "string", "description": "Platform id. Omit when the project has a single platform." },
        "area": { "type": "string", "description": "Area id, or free text when no matching area exists." },
        "severity": { "type": ["string", "null"], "description": "Severity id, or null for unranked items (e.g. root causes)." },
        "status": { "$ref": "#/$defs/issueStatus", "default": "open" },
        "title": { "type": "string", "minLength": 1, "description": "Plain text one-liner." },
        "details": { "$ref": "#/$defs/rich" },
        "note": { "$ref": "#/$defs/rich", "description": "Resolution note, e.g. what the fix did." },
        "where": { "$ref": "#/$defs/rich", "description": "Location in code, e.g. file:line." },
        "date": { "type": "string" },
        "top": { "type": "boolean", "description": "List in the Overview's top issues." },
        "rank": { "type": "integer", "description": "Order within the top issues (ascending)." },
        "counted": { "type": "boolean", "default": true, "description": "false = summary row restating other issues: shown in top issues, excluded from totals." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Free tags; \"root-cause\" is shown as a badge." },
        "screenshots": { "type": "array", "items": { "$ref": "#/$defs/image" } }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["before"] }, { "required": ["after"] }],
      "properties": {
        "before": { "$ref": "#/$defs/image" },
        "after": { "$ref": "#/$defs/image" },
        "caption": { "$ref": "#/$defs/rich", "description": "Shared caption for the pair." }
      }
    },
    "fixPlatform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "$ref": "#/$defs/rich" },
        "pairs": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "images": { "type": "array", "items": { "$ref": "#/$defs/image" }, "description": "Extra screenshots that are not before/after." }
      }
    },
    "fix": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "number": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "date": { "type": "string" },
        "summary": { "$ref": "#/$defs/rich", "description": "What changed and why." },
        "files": { "type": "array", "items": { "type": "string" } },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sha"],
            "additionalProperties": false,
            "properties": {
              "sha": { "type": "string", "minLength": 4 },
              "url": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "issues": { "type": "array", "items": { "type": "string" }, "description": "Issue ids this fix addresses." },
        "platforms": {
          "type": "object",
          "description": "Keyed by platform id.",
          "additionalProperties": { "$ref": "#/$defs/fixPlatform" }
        }
      }
    },
    "planStatus": { "enum": ["todo", "doing", "partial", "done", "dropped"] },
    "planItem": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "phase": { "type": "string" },
        "severity": { "type": ["string", "null"] },
        "title": { "$ref": "#/$defs/rich", "description": "The change, inline rich text." },
        "details": { "$ref": "#/$defs/rich" },
        "files": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "effort": { "type": "string" },
        "status": { "$ref": "#/$defs/planStatus", "default": "todo" },
        "note": { "$ref": "#/$defs/rich" },
        "issues": { "type": "array", "items": { "type": "string" } },
        "fixes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "planGroup": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "platform": { "type": "string" },
        "intro": { "$ref": "#/$defs/rich" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/planItem" } }
      }
    },
    "appendixEntry": {
      "type": "object",
      "required": ["title", "body"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "platform": { "type": "string" },
        "body": { "$ref": "#/$defs/rich" }
      }
    },
    "refId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$", "description": "Lower-case id safe to use in a git branch name (design/<proposal>/<option>)." },
    "level": { "enum": ["low", "medium", "high"] },
    "size": { "enum": ["S", "M", "L"] },
    "inlineList": { "type": "array", "items": { "type": "string" }, "description": "Short inline rich-text items." },
    "source": {
      "type": "object",
      "required": ["label", "href"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1, "description": "URL, or a path relative to review.json." },
        "accessed": { "type": "string", "description": "When a web source was read, ISO 8601 date." },
        "quote": { "type": "string", "description": "A short excerpt or number from the source, verbatim." },
        "kind": { "type": "string", "description": "Optional hint: standard, docs, study, article, code, issue, product, ..." }
      }
    },
    "research": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "description": "Plain text one-liner: the finding." },
        "summary": { "$ref": "#/$defs/rich", "description": "What was found; keep facts apart from inference." },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "confidence": { "$ref": "#/$defs/level" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string" }
      }
    },
    "ideaStatus": { "enum": ["proposed", "go", "maybe", "no", "done"] },
    "idea": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "description": "Plain text one-liner." },
        "status": { "$ref": "#/$defs/ideaStatus", "default": "proposed" },
        "problem": { "$ref": "#/$defs/rich" },
        "proposal": { "$ref": "#/$defs/rich" },
        "reasoning": { "$ref": "#/$defs/rich", "description": "Why this, why now, and how the evidence supports it." },
        "evidence": { "type": "array", "items": { "type": "string" }, "description": "Research ids this idea rests on." },
        "alternatives": { "$ref": "#/$defs/rich", "description": "What else was considered (including doing nothing) and why not." },
        "risks": { "$ref": "#/$defs/rich", "description": "What could go wrong and how to reduce it." },
        "pros": { "$ref": "#/$defs/inlineList" },
        "cons": { "$ref": "#/$defs/inlineList" },
        "effort": { "$ref": "#/$defs/size" },
        "impact": { "$ref": "#/$defs/size" },
        "confidence": { "$ref": "#/$defs/level" },
        "decision": { "$ref": "#/$defs/rich", "description": "The user's call and why." },
        "proposals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Design proposal ids (they may live in the design review)."
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string" },
        "rank": { "type": "integer", "description": "Order in the shortlist (ascending)." }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "weight": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1 },
        "description": { "type": "string" }
      }
    },
    "score": {
      "type": "object",
      "required": ["score"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": "integer", "minimum": 1, "maximum": 5 },
        "note": { "$ref": "#/$defs/rich", "description": "Why this score." }
      }
    },
    "diffFile": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "add": { "type": "integer", "minimum": 0 },
        "del": { "type": "integer", "minimum": 0 },
        "binary": { "type": "boolean" }
      }
    },
    "diff": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1, "description": "The diff snapshot, relative to review.json (e.g. diffs/<proposal>--<option>.patch)." },
        "files": { "type": "array", "items": { "$ref": "#/$defs/diffFile" } },
        "insertions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean", "description": "The snapshot was cut at the size cap." }
      }
    },
    "optionPlatform": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "description": { "$ref": "#/$defs/rich" }, "images": { "type": "array", "items": { "$ref": "#/$defs/image" } } }
    },
    "optionStatus": { "enum": ["proposed", "adopted", "rejected"] },
    "option": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/refId" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/optionStatus", "default": "proposed" },
        "summary": { "$ref": "#/$defs/rich", "description": "What this option does and what makes it distinct." },
        "reasoning": { "$ref": "#/$defs/rich" },
        "pros": { "$ref": "#/$defs/inlineList" },
        "cons": { "$ref": "#/$defs/inlineList" },
        "scores": { "type": "object", "description": "Keyed by criterion id.", "additionalProperties": { "$ref": "#/$defs/score" } },
        "evidence": { "$ref": "#/$defs/rich", "description": "Test output, measurements, lint results." },
        "branch": { "type": "string", "description": "design/<proposal>/<option>" },
        "base": { "type": "string", "description": "Commit the branch started from." },
        "head": { "type": "string", "description": "Branch head when the diff snapshot was taken." },
        "worktree": { "type": "string", "description": "Worktree folder relative to the repository root (never absolute)." },
        "gone": { "type": "boolean", "description": "The branch and worktree were removed with `review-kit discard`; the snapshot remains." },
        "diff": { "$ref": "#/$defs/diff" },
        "platforms": {
          "type": "object",
          "description": "Keyed by platform id.",
          "additionalProperties": { "$ref": "#/$defs/optionPlatform" }
        }
      }
    },
    "proposalStatus": { "enum": ["open", "adopted", "closed"] },
    "proposal": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/refId" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/proposalStatus", "default": "open" },
        "brief": { "$ref": "#/$defs/rich", "description": "What is being decided, and the constraints." },
        "idea": { "type": "string", "description": "The idea this proposal comes from (it may live in the ideas review)." },
        "date": { "type": "string" },
        "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
        "recommendation": {
          "type": "object",
          "required": ["option"],
          "additionalProperties": false,
          "properties": {
            "option": { "type": "string" },
            "reasoning": { "$ref": "#/$defs/rich", "description": "Why it wins, and when another option would be the better choice." }
          }
        },
        "decision": { "$ref": "#/$defs/rich" },
        "adopted": {
          "type": "object",
          "required": ["option"],
          "additionalProperties": false,
          "properties": { "option": { "type": "string" }, "commit": { "type": "string" }, "date": { "type": "string" } }
        },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } }
      }
    },
    "prComment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "description": "Markdown, as written on GitHub."
        },
        "created": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "prCheck": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "description": "COMPLETED, IN_PROGRESS, QUEUED, PENDING, ..."
        },
        "conclusion": {
          "type": [
            "string",
            "null"
          ],
          "description": "SUCCESS, FAILURE, CANCELLED, SKIPPED, TIMED_OUT, ACTION_REQUIRED, NEUTRAL, or null while running."
        },
        "url": {
          "type": "string"
        },
        "runId": {
          "type": "integer",
          "minimum": 1,
          "description": "GitHub Actions run id (from the details URL), for re-runs."
        }
      }
    },
    "prReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "description": "APPROVED, CHANGES_REQUESTED, COMMENTED, DISMISSED"
        },
        "submitted": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "description": "Head commit the review was made on."
        }
      }
    },
    "prThread": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "GraphQL node id (PRRT_...)."
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "resolved": {
          "type": "boolean"
        },
        "outdated": {
          "type": "boolean"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prComment"
          }
        }
      }
    },
    "prFile": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "add": {
          "type": "integer",
          "minimum": 0
        },
        "del": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "prGh": {
      "type": "object",
      "description": "Synced from GitHub by `review-kit pr sync` (replaced as a whole on every sync).",
      "required": [
        "fetched"
      ],
      "additionalProperties": false,
      "properties": {
        "fetched": {
          "type": "string",
          "description": "When it was synced (ISO 8601)."
        },
        "viewer": {
          "type": "string",
          "description": "The GitHub login gh was authenticated as."
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "state": {
          "enum": [
            "OPEN",
            "MERGED",
            "CLOSED"
          ]
        },
        "draft": {
          "type": "boolean"
        },
        "author": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "headSha": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "updated": {
          "type": "string"
        },
        "mergedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "mergeable": {
          "type": "string",
          "description": "MERGEABLE, CONFLICTING or UNKNOWN"
        },
        "mergeState": {
          "type": "string",
          "description": "CLEAN, BLOCKED, BEHIND, DIRTY, UNSTABLE, HAS_HOOKS, DRAFT or UNKNOWN"
        },
        "reviewDecision": {
          "type": [
            "string",
            "null"
          ],
          "description": "APPROVED, CHANGES_REQUESTED, REVIEW_REQUIRED or null"
        },
        "additions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        },
        "changedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewRequests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prCheck"
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prReview"
          }
        },
        "threads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prThread"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prComment"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prFile"
          }
        },
        "diff": {
          "type": "string",
          "minLength": 1,
          "description": "The PR's diff, relative to review.json (diffs/<id>.diff), capped at 2 MB."
        },
        "diffTruncated": {
          "type": "boolean"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "title",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,40}$",
          "description": "Unique within the PR, e.g. f-1."
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "nit"
          ],
          "default": "P1"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "description": "Markdown: exactly what would be posted."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "File the comment is on; none = a general comment."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "side": {
          "enum": [
            "LEFT",
            "RIGHT"
          ],
          "default": "RIGHT"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "ship": {
          "type": "boolean",
          "default": false,
          "description": "The user's flag: include in the next review sent to GitHub."
        },
        "status": {
          "enum": [
            "draft",
            "posted",
            "dropped"
          ],
          "default": "draft"
        },
        "sha": {
          "type": "string",
          "description": "Head commit the finding was written against."
        },
        "posted": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "reviewId": {
              "type": "integer"
            },
            "sha": {
              "type": "string"
            }
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "event"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "enum": [
            "COMMENT",
            "APPROVE",
            "REQUEST_CHANGES"
          ]
        },
        "body": {
          "type": "string",
          "description": "Markdown summary for the next review."
        }
      }
    },
    "pr": {
      "type": "object",
      "required": [
        "id",
        "repo",
        "number",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,150}$",
          "description": "<owner>-<repo>-<number>, lower-case."
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._][A-Za-z0-9._-]{0,99}$",
          "description": "owner/name"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "mine",
            "reviewing"
          ],
          "default": "mine",
          "description": "mine: a PR you shepherd; reviewing: someone else's PR you review."
        },
        "priority": {
          "type": "integer",
          "description": "Lower = more urgent."
        },
        "next": {
          "type": "string",
          "description": "Plain text: the next step."
        },
        "notes": {
          "$ref": "#/$defs/rich"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "PR ids that must merge first."
        },
        "added": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "gh": {
          "$ref": "#/$defs/prGh"
        }
      }
    }
  }
}
