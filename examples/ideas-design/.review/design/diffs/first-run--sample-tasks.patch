 // Pocket Tasks: a tiny task list. A first-time user starts with no tasks.
-const tasks = [];
+const SAMPLES = [
+  { text: 'Tick this box to finish a task', done: false },
+  { text: 'Add your own task in the box above', done: false },
+  { text: 'Delete a task with the × button', done: false },
