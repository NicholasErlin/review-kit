+import { http } from '../api/http';
+import type { Cart, Coupon } from './types';
+
+export async function applyCoupon(cart: Cart, code: string): Promise<Cart> {
+  const res = await http.get<Coupon>(`/coupons/${code}`);
+  if (res.percent > 100) throw new Error('Invalid coupon');
+  return { ...cart, coupon: res };
+}
+
+export function couponError(e: unknown): string {
+  if (e instanceof Error) return e.message;
+  return 'Something went wrong';
+}
