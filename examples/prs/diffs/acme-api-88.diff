diff --git a/app/payments/idempotency.py b/app/payments/idempotency.py
new file mode 100644
index 0000000..0d9e8b2
--- /dev/null
+++ b/app/payments/idempotency.py
@@ -0,0 +1,22 @@
+"""Remember the response to a payment request by its Idempotency-Key for 24 hours."""
+from datetime import datetime, timedelta, timezone
+
+from sqlalchemy.orm import Session
+
+from app.models import IdempotentResponse
+
+TTL = timedelta(hours=24)
+
+
+def lookup(db: Session, key: str) -> IdempotentResponse | None:
+    row = db.get(IdempotentResponse, key)
+    if row is None or row.created < datetime.now(timezone.utc) - TTL:
+        return None
+    return row
+
+
+def store(db: Session, key: str, order_id: str, response) -> None:
+    db.add(IdempotentResponse(key=key, order_id=order_id, response=response))
+    db.commit()
