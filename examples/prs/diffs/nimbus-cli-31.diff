+
+func TestConfigPathXDG(t *testing.T) {
+	t.Setenv("XDG_CONFIG_HOME", "/tmp/xdg")
+	got, err := configPath()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "/tmp/xdg/nimbus/config.toml"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
