+export interface PayOptions { idempotencyKey: string }
+
+export async function submitPayment(orderId: string, opts: PayOptions): Promise<void> {
+  await http.post(`/orders/${orderId}/pay`, null, {
+    headers: { 'Idempotency-Key': opts.idempotencyKey },
+  });
 }
