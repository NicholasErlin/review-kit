diff --git a/src/checkout/useIdempotencyKey.ts b/src/checkout/useIdempotencyKey.ts
new file mode 100644
index 0000000..c4d2e11
--- /dev/null
+++ b/src/checkout/useIdempotencyKey.ts
@@ -0,0 +1,14 @@
+import { useMemo } from 'react';
+
+/** One key per order and page load, so a double click never charges twice. */
+export function useIdempotencyKey(orderId: string): string {
+  return useMemo(() => {
+    const stored = sessionStorage.getItem('idem:' + orderId);
+    if (stored) return stored;
+    const key = crypto.randomUUID();
+    sessionStorage.setItem('idem:' + orderId, key);
+    return key;
+  }, [orderId]);
+}
+
+export default useIdempotencyKey;
